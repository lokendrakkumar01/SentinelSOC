# ═══════════════════════════════════════════════════════════
# SentinelSOC Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════

# ─── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB ───────────────────────────────────────────────
MONGO_USER=sentinelsoc
MONGO_PASSWORD=sentinelsoc_secret
MONGODB_URI=mongodb://sentinelsoc:sentinelsoc_secret@localhost:27017/sentinelsoc?authSource=admin

# ─── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT Authentication ───────────────────────────────────
JWT_SECRET=sentinelsoc_jwt_super_secret_key_change_in_production
JWT_EXPIRY=24h

# ─── Slack Notifications (optional) ───────────────────────
# Create a Slack Incoming Webhook: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# ─── Email Notifications (optional) ──────────────────────
# Use Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
# Use Mailtrap for testing: https://mailtrap.io
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@sentinelsoc.io

# ─── Java Log Agent ──────────────────────────────────────
API_URL=http://localhost:5000/api/logs
LOG_INTERVAL=1500
